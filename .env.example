# Browser calls the same origin; Vite forwards to the Flask URL in openapi.yml.
# Keep this for iPhone/tunnel tests to avoid HTTP mixed content and phone localhost.
VITE_API_BASE_URL=/api/v1
API_PROXY_TARGET=http://localhost:5000
VITE_DATA_MODE=server
# openapi follows the supplied YAML. legacy-source adapts older auth field names.
VITE_API_PROFILE=openapi
# Group 4 FastAPI. Keep same-origin on phones; no JWT is sent to this service.
VITE_LIVENESS_BASE_URL=/liveness-api
LIVENESS_PROXY_TARGET=http://127.0.0.1:8000
